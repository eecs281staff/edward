#!/usr/bin/env python3

from edstem.client import Client
from edstem.models import NewThread
from env import settings

ed_client = Client(settings.EDSTEM_API_KEY, authentication="bearer")

result = ed_client.create_thread(
    settings.COURSE_ID,
    NewThread(
        title="test",
        category="General",
        content='<document version="2.0"><paragraph>test</paragraph></document>',
        type="question",
    ),
)

if result.is_err():
    raise Exception(f"Failed to create question: {result.error}")

thread = result.unwrap().thread
print(thread.id, thread.number, thread.title)
