#Obtain from https://edstem.org/us/settings/api-tokens
EDSTEM_API_KEY=
# Login for the bot's edstem account, used to get the stream's session token
# best way to do this is make an email group and an Ed account with that
EDSTEM_EMAIL=
EDSTEM_PASSWORD=


# Edstem course ID
COURSE_ID=


# Obtained from the bot config page
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Channel the canary posts its heartbeat in
SLACK_CANARY_CHANNEL_ID=


# [OPTIONAL] Discord webhook for announcement forwarding. Obtain by right clicking the discord channel, then
# click Edit Channel > Integrations > Create Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
